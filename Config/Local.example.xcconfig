// Copy to Config/Local.xcconfig (gitignored) and fill in. Orbit.xcconfig includes it last, so values here win.

// Client ID of your app in the Spotify Developer Dashboard, with redirect URI http://127.0.0.1:8888/callback.
// Users can also enter one in Orbit's settings, which takes precedence over this build-time value.
SPOTIFY_CLIENT_ID = your_client_id_here

// Optional: sign with a real identity instead of ad-hoc. A stable signature stops macOS from re-asking for
// Keychain and Automation access after every build.
// CODE_SIGN_STYLE = Automatic
// CODE_SIGN_IDENTITY = Apple Development
// DEVELOPMENT_TEAM = ABCDE12345
