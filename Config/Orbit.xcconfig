// Shared build settings for the Orbit app target. Machine-specific values (Spotify Client ID, signing identity)
// belong in the gitignored Config/Local.xcconfig; copy Config/Local.example.xcconfig to start one.

PRODUCT_NAME = Orbit
PRODUCT_BUNDLE_IDENTIFIER = io.github.ntony46.orbit
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0

INFOPLIST_FILE = App/Info.plist
CODE_SIGN_ENTITLEMENTS = App/Orbit.entitlements
ENABLE_HARDENED_RUNTIME = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Ad-hoc "Sign to Run Locally", so anyone can build without a paid developer account.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
// A development identity would otherwise add get-task-allow, which lets other processes attach to a Release build.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

SPOTIFY_CLIENT_ID =

#include? "Local.xcconfig"
